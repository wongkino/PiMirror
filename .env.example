# PiMirror Docker — copy to .env and edit:
#   cp .env.example .env

# ── Compose / host ──────────────────────────
# UID/GID must match the Pi login user (id -u / id -g).
UID=1000
GID=1000
# Must exist before kiosk start — usually /run/user/$UID after login or linger.
# Check: ls -la /run/user/$(id -u)
# If missing: loginctl enable-linger $USER && reboot
XDG_RUNTIME_DIR=/run/user/1000
WAYLAND_DISPLAY=wayland-0
DISPLAY=:0
PIMIRROR_IMAGE=ghcr.io/wongkino/pimirror:latest

# ── App（對應 dashboard server）──────────────
DASHBOARD_PORT=8090

HKO_STATION=元朗公園

CALENDAR_URL=
CALENDAR_NAME=行事曆
CALENDAR_COLOR=#0a84ff
HOLIDAYS_ICS_URL=https://www.1823.gov.hk/common/ical/tc.ics

HA_URL=http://10.0.0.2:8123
HA_HOST=10.0.0.2
HA_PORT=8123
HA_TOKEN=
