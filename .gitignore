# Never commit module dependencies (install per module as needed).
modules/**/node_modules/

# Track shared config (env placeholders) but keep secrets local.
config/*
!config/config.js
!config/config.js.sample
!config/custom.css
!config/custom.css.sample
!config/config.env.sample
!config/homeassistant/
!config/homeassistant/**
config/homeassistant/magicmirror_screen.yaml

# Local secrets / generated (redundant with config/* but explicit)
config/basepath.js

# Local tooling / backups (not part of runtime)
config-hk-toolkit/
defaultmodules/weather/.backup-pre-animated/

# Vim
## swap
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]

## diff patch
*.orig
*.rej
*.bak

# Ignore positions file (#3518)
js/positions.js

# Ignore lock files other than package-lock.json
pnpm-lock.yaml
yarn.lock

# Vitest temporary test files
tests/**/.tmp/
