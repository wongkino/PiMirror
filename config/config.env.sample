# Copy to config.env and fill in private values:
#   cp config/config.env.sample config/config.env
#
# Note: Avoid SECRET_ for calendar URLs and weather station names.
# Default calendar/weather modules pass config via the browser and
# do not restore **SECRET_*** placeholders.

CALENDAR_URL="https://p40-caldav.icloud.com/published/2/YOUR_PUBLISHED_CALENDAR_TOKEN"
CALENDAR_NAME="行事曆"
CALENDAR_COLOR="#58a6ff"
HOLIDAYS_ICS_URL="https://www.1823.gov.hk/common/ical/tc.ics"
HKO_STATION="元朗公園"

# KMB: 洪水橋(洪福邨)總站 — https://winstonma.github.io/MMM-HK-Transport-ETA-Configurator/
KMB_STOP_ID="2DDEDEFABFB2ED87"


# UniFi Protect (MMM-UniFiProtect) — local admin
UNIFI_PROTECT_HOST=""
UNIFI_PROTECT_USERNAME=""
UNIFI_PROTECT_PASSWORD=""
UNIFI_PROTECT_API_KEY=""
UNIFI_PROTECT_CAMERA_NAME=""
UNIFI_PROTECT_CAMERA_NAME_2=""
UNIFI_PROTECT_CAMERA_NAMES=""

# Sonarr (MMM-Sonarr) — Settings → General → API Key
# Example: SONARR_BASE_URL="http://10.0.0.50:8989"
SONARR_BASE_URL=""
SONARR_API_KEY=""

# Home Assistant
HA_URL=http://10.0.0.2:8123
HA_HOST=10.0.0.2
HA_PORT=8123
HA_TOKEN=

# Password for http://<host>:8080/admin/
# Set on first visit (or via Admin「變更密碼」). Stored as scrypt hash only.
# ADMIN_PASSWORD_HASH is written automatically — do not put plaintext here.

# MagicMirror Remote Control (HA 控制螢幕)
MAGICMIRROR_HOST=10.0.1.125
MAGICMIRROR_PORT=8080
MM_REMOTE_API_KEY=
