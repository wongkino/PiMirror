# PiMirror — copy to config.env:
#   cp config/config.env.sample config/config.env
#
# Modes:
#   local | realtime  — run full MagicMirror on this Pi (GPIO / node_helper OK)
#   client            — Electron UI only; config/helpers from remote server

MM_MODE=local

# Used only when MM_MODE=client
MM_SERVER_ADDRESS=10.0.1.20
MM_SERVER_PORT=13006
MM_SERVER_TLS=false
